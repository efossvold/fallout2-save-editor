{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Fallout 2 save game editor",
  "type": "module",
  "scripts": {
    "build": "vite-react-ssg build",
    "build:prod": "bun run prepare:prod && bun run build",
    "devtools": "vite build",
    "analyze": "vite analyze",
    "deploy": "bunx netlify-cli deploy",
    "deploy:prod": "git hook run pre-commit && bunx netlify-cli deploy --prod",
    "dev": "vite dev",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt",
    "lint:watch": "watchexec -w src -c -- bun run lint",
    "lint": "oxlint -c oxlint.config.ts --fix -f stylish",
    "prepare": "panda codegen --clean",
    "prepare:prod": "NODE_ENV=production panda codegen --clean",
    "preview": "vite preview",
    "test:watch": "bun test --watch",
    "test": "bun test",
    "compress": "find dist -type f -exec brotli -jf {} \\;",
    "mkcert": "mkcert icert.org -install",
    "serve": "http-server dist/ -bS -C cert/icert.org+1.pem -K cert/icert.org+1-key.pem"
  },
  "dependencies": {
    "immer": "^11.1.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "reselect": "^5.2.0",
    "vite-react-ssg": "^0.9.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.11.5",
    "@pandacss/eslint-plugin": "^0.3.2",
    "@pandacss/vite": "^2.0.0-beta.9",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/devtools": "^0.4.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "netlify-cli": "^26.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-bundle-analyzer": "^1.3.9",
    "watch-exec": "^1.2.2"
  }
}
