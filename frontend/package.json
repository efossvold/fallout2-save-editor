{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Fallout 2 save game editor",
  "type": "module",
  "scripts": {
    "analyze": "vite analyze",
    "build:all": "bun run build:clean && bun run build && bun run build:server && bun run build:ssg",
    "build:clean": "rm -rf dist/*",
    "build:dev": "bun run pandagen && vite dev",
    "build:server": "vite build --outDir dist/server --ssr ./src/entry-server.ts",
    "build:ssg": "bun run ./dist/server/entry-server.js",
    "build": "bun run pandagen:prod && vite build --outDir dist/client",
    "compress": "find dist -type f -exec brotli -jf {} \\;",
    "deploy:prod": "git hook run pre-commit && bunx netlify-cli deploy --prod",
    "deploy": "bunx netlify-cli deploy",
    "dev": "bun run pandagen && vite dev",
    "devtools": "vite build",
    "doctor": "react-doctor --no-lint",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt",
    "lint:watch": "watchexec -w src -c -- bun run lint",
    "lint": "oxlint -c oxlint.config.ts --fix -f stylish",
    "mkcert": "mkcert icert.org -install",
    "pandagen:prod": "NODE_ENV=production panda codegen --clean",
    "pandagen": "panda codegen --clean",
    "preview": "vite preview",
    "serve": "http-server dist/client -bS -C cert/icert.org+1.pem -K cert/icert.org+1-key.pem",
    "test:watch": "bun test --watch",
    "test": "bun test"
  },
  "dependencies": {
    "@octanejs/vite-plugin": "^0.1.22",
    "@octanejs/zustand": "^0.1.21",
    "@wailsio/runtime": "latest",
    "mutative": "^1.3.0",
    "octane": "^0.1.22",
    "react-hot-toast": "^2.6.0",
    "reselect": "^5.2.0",
    "vite-react-ssg": "^0.9.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@octanejs/cli": "^0.0.2",
    "@pandacss/dev": "^1.12.0",
    "@pandacss/eslint-plugin": "^0.3.2",
    "@pandacss/vite": "^2.0.0-beta.11",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/devtools": "^0.4.10",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "netlify-cli": "^27.0.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-bundle-analyzer": "^1.3.9",
    "watch-exec": "^1.2.2"
  }
}
